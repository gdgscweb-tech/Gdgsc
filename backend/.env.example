# ==============================================================================
# GDGSC Backend Environment Variables Example
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Frontend & Backend URLs
DEV_FRONTEND_URL=http://localhost:3000
DEV_BACKEND_URL=http://localhost:5000
PROD_FRONTEND_URL=https://www.gdgsc.dev
PROD_BACKEND_URL=https://api.gdgsc.dev

# ==============================================================================
# Database Configuration (MongoDB) — Environment Separated
# ==============================================================================
# Development MongoDB URI (Local instance or isolated dev cluster)
# Defaults to mongodb://127.0.0.1:27017/gdgsc_dev if not provided in development
DEV_MONGO_URI=mongodb://127.0.0.1:27017/gdgsc_dev

# Production MongoDB URI (Required when NODE_ENV=production)
# Set in your production hosting dashboard (Render / Heroku / Railway)
PROD_MONGO_URI=mongodb+srv://<prod_db_user>:<prod_password>@<prod_cluster>.mongodb.net/gdgsc_prod?retryWrites=true&w=majority

# Authentication & Sessions
JWT_SECRET=your_strong_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# OAuth Providers (Optional for local development)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
DEV_GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
PROD_GOOGLE_CALLBACK_URL=https://api.gdgsc.dev/api/auth/google/callback

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DEV_DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/discord/callback
PROD_DISCORD_CALLBACK_URL=https://api.gdgsc.dev/api/auth/discord/callback

# ==============================================================================
# Storage Provider Configuration (google_drive | r2)
# ==============================================================================
STORAGE_PROVIDER=google_drive

# ==============================================================================
# Google Drive Storage Configuration
# ==============================================================================
# Target Root Folder ID where game assets will be stored
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Service Account Credentials (Recommended for Server-to-Server API)
GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account@project-id.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional OAuth2 Refresh Token (Alternative to Service Account)
GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token

# ==============================================================================
# Cloudflare R2 Object Storage Configuration (Alternative Provider)
# ==============================================================================
# Get these credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gdgsc-game-assets

# Optional Public / CDN domain (e.g., https://assets.gdgsc.dev or Cloudflare R2 dev URL)
# If provided, public assets (images, trailers) will be served via this URL directly
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# Storage Limits & Expiry (Optional overrides, defaults shown)
# Maximum file sizes in bytes
MAX_FILE_SIZE_GAME_BYTES=5368709120   # 5 GB for game builds (.zip, .rar, .7z, .exe)
MAX_FILE_SIZE_VIDEO_BYTES=524288000   # 500 MB for trailers/gameplay videos
MAX_FILE_SIZE_IMAGE_BYTES=20971520    # 20 MB for banners, screenshots, covers
MAX_FILE_SIZE_ASSET_BYTES=104857600   # 100 MB for config/misc assets

# Presigned URL Expirations in seconds
PRESIGNED_UPLOAD_EXPIRY_SECONDS=900    # 15 minutes
PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=3600 # 1 hour

# Multipart Upload Threshold in bytes (files above this should use multipart)
MULTIPART_THRESHOLD_BYTES=20971520     # 20 MB

# Legacy Cloudinary Configuration (Optional fallback for events)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Features
ENABLE_GAMES=true
